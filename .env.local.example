# ── 네이버 뉴스 검색 API ────────────────────────────────────────
# NAVER API HUB(https://www.ncloud.com/product/applicationService/naverApiHub)에서 발급받은 값을 채운다.
# 서버에서만 읽히며 브라우저로 나가지 않는다.
NAVER_API_KEY_ID=
NAVER_API_KEY=

# ── Supabase (읽음 표시·북마크·키워드 설정 저장) ────────────────
# Supabase 대시보드 > Project Settings > API 에서 가져온다.
# 이 두 값은 NEXT_PUBLIC_ 이라 브라우저에 노출되는 게 정상이다.
# 실제 보안은 supabase/schema.sql 의 RLS 정책이 담당한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
